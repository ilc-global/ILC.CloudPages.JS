# Copy to scripts/cdn.env and fill in. cdn.env is gitignored: the target
# account is infrastructure detail and does not belong in a public repo.
CDN_ACCOUNT=
CDN_SUBSCRIPTION=
CDN_BASE_URL=https://<account>.<zone>.web.core.windows.net
# login = Entra ID via `az login` (preferred). key = storage account keys.
CDN_AUTH_MODE=login
